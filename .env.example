# ============================================================
# GeoWise local environment template
# Copy to .env (frontend) or backend/jal_saheli/.env
# Never commit real secrets.
# ============================================================

# Frontend (Vite) — leave empty to use the Vite/nginx /api proxy
VITE_API_BASE_URL=

# Backend
APP_ENV=development
APP_TITLE=GeoWise Backend API
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Local SQLite (no Docker required)
DATABASE_URL=sqlite+aiosqlite:///./geowise_dev.db

# Docker Compose PostGIS example:
# DATABASE_URL=postgresql+asyncpg://geowise:geowise@db:5432/geowise

JWT_SECRET_KEY=CHANGEME_generate_a_real_secret_here
GEOAI_CONFIDENCE_THRESHOLD=0.75
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# Optional: directory containing lulc_rf_model_final.pkl and satellite_lookup.npz
GEOAI_MODEL_DIR=

# Optional Bhuvan WMS (ISRO) — disabled by default
BHUVAN_ENABLED=false
BHUVAN_WMS_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms
BHUVAN_LAYER=lulc:BR_LULC50K_1112
AI_SERVICE_URL=
SENTINEL_USERNAME=
SENTINEL_PASSWORD=
