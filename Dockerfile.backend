FROM python:3.12-slim
WORKDIR /app
COPY backend/jal_saheli/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/jal_saheli/ .
COPY backend/lulc_rf_model_final.pkl /app/geoai_assets/lulc_rf_model_final.pkl
COPY backend/satellite_lookup.npz /app/geoai_assets/satellite_lookup.npz
ENV PYTHONUNBUFFERED=1
ENV GEOAI_MODEL_DIR=/app/geoai_assets
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
