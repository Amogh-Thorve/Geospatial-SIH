# ============================================================
# Jal Saheli Backend — Environment Variable Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ────────────────────────────────────────────────────────────
# APPLICATION
# ────────────────────────────────────────────────────────────

# Runtime environment: development | test | production
APP_ENV=development

# API title shown in /docs
APP_TITLE=GeoWise Backend API

# Semantic version
APP_VERSION=1.0.0

# Debug mode (set false in production)
DEBUG=true

# Host and port for uvicorn
HOST=0.0.0.0
PORT=8000

# ────────────────────────────────────────────────────────────
# DATABASE
# ────────────────────────────────────────────────────────────

# Async PostgreSQL connection string
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# For local development with SQLite (no PostgreSQL required):
#   DATABASE_URL=sqlite+aiosqlite:///./jal_saheli_dev.db
DATABASE_URL=postgresql+asyncpg://jalsaheli_user:CHANGEME@localhost:5432/jal_saheli_db

# Maximum pool connections
DB_POOL_SIZE=10

# Connections that can overflow pool temporarily
DB_MAX_OVERFLOW=20

# SQLAlchemy echo (logs all SQL statements — set false in production)
DB_ECHO=false

# ────────────────────────────────────────────────────────────
# AUTHENTICATION
# ────────────────────────────────────────────────────────────

# JWT signing secret — MUST be changed before deployment
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGEME_generate_a_real_secret_here

# JWT algorithm
JWT_ALGORITHM=HS256

# Access token expiry in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP expiry in minutes
OTP_EXPIRE_MINUTES=10

# OTP length (digits)
OTP_LENGTH=6

# ────────────────────────────────────────────────────────────
# TELEGRAM
# ────────────────────────────────────────────────────────────

# Bot token from @BotFather on Telegram
# Leave empty to disable Telegram integration at startup
TELEGRAM_BOT_TOKEN=

# Webhook URL (for production webhook mode)
# e.g. https://yourdomain.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# Webhook secret token (set in BotFather)
TELEGRAM_WEBHOOK_SECRET=

# ────────────────────────────────────────────────────────────
# AI SERVICE (GeoBrain / Vision Model)
# ────────────────────────────────────────────────────────────

# Base URL of the AI inference endpoint
# Leave empty — local Ved Geo AI does not use this URL
AI_SERVICE_URL=

# Directory with lulc_rf_model_final.pkl and satellite_lookup.npz (optional)
GEOAI_MODEL_DIR=

# API key for the AI service (if required)
AI_SERVICE_API_KEY=

# Request timeout in seconds
AI_REQUEST_TIMEOUT_SECONDS=30

# ────────────────────────────────────────────────────────────
# SATELLITE SERVICE (Sentinel-2 / Copernicus)
# ────────────────────────────────────────────────────────────

# Copernicus Data Space Ecosystem credentials
# Register free at: https://dataspace.copernicus.eu/
SENTINEL_USERNAME=
SENTINEL_PASSWORD=

# Alternative: Sentinel Hub OAuth client
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# Request timeout in seconds
SATELLITE_REQUEST_TIMEOUT_SECONDS=60

# ────────────────────────────────────────────────────────────
# BHUVAN (ISRO OGC WMS — optional satellite imagery provider)
# Official docs: https://bhuvan.nrsc.gov.in/wiki/index.php/How_to_use_WMS_services
# ────────────────────────────────────────────────────────────

# Set true to attempt Bhuvan WMS GetMap during Geo AI analysis
BHUVAN_ENABLED=false

# WMS endpoint (default official Bhuvan vec2 server when empty)
BHUVAN_WMS_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms

# Example thematic LULC layer from Bhuvan wiki (regional coverage varies by layer)
BHUVAN_LAYER=lulc:BR_LULC50K_1112

# OGC WMS version / CRS / image format
BHUVAN_VERSION=1.1.1
BHUVAN_CRS=EPSG:4326
BHUVAN_FORMAT=image/png

# HTTP timeout (seconds) for GetCapabilities / GetMap
BHUVAN_TIMEOUT=15

# Bhuvan LULC Statistics / AOI Wise (requires access token from Bhuvan API portal)
BHUVAN_LULC_ENABLED=false
BHUVAN_ACCESS_TOKEN=
BHUVAN_LULC_YEAR=2015_16
BHUVAN_LULC_API_BASE=https://bhuvan-app1.nrsc.gov.in/api
BHUVAN_LULC_AOI_DELTA=0.01

# ────────────────────────────────────────────────────────────
# STORAGE (Photo files)
# ────────────────────────────────────────────────────────────

# Storage backend: local | s3 | gcs
STORAGE_BACKEND=local

# Local storage: directory path (relative or absolute)
LOCAL_STORAGE_DIR=./uploads

# S3 (if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# GCS (if STORAGE_BACKEND=gcs)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Max uploaded photo size in bytes (default: 10 MB)
MAX_PHOTO_SIZE_BYTES=10485760

# ────────────────────────────────────────────────────────────
# CORS
# ────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins
# In development include the Vite dev server port(s)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
