# SQLite (no PostgreSQL needed) for tests
APP_ENV=test
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./jal_saheli_test.db
DB_ECHO=false
JWT_SECRET_KEY=test-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
AI_SERVICE_URL=
AI_SERVICE_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=5
SENTINEL_USERNAME=
SENTINEL_PASSWORD=
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
SATELLITE_REQUEST_TIMEOUT_SECONDS=5
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./test_uploads
MAX_PHOTO_SIZE_BYTES=10485760
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
